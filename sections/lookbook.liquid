{%- assign product = section.settings.product -%}
<section class="lookbook">
  <div class="container">
    <div class="lookbook-grid reveal">
      <div class="lookbook-media">
        {%- render 'placeholder-media', image: section.settings.image, modifier: 'photo' -%}
      </div>
      <div class="lookbook-copy">
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <div class="collection">{{ section.settings.collection_label }}</div>
        <h2>{{ product.title | default: section.settings.heading }}</h2>
        <p class="desc">{{ section.settings.description | default: product.description | strip_html | truncate: 140 }}</p>
        <span class="price-tag">{% if product %}{{ product.price | money }}{% else %}{{ section.settings.price_label }}{% endif %}</span>
        <a href="{{ product.url | default: '#' }}" class="btn btn-primary">{{ section.settings.cta_label }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop the look",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Adopte le look" },
    { "type": "text", "id": "collection_label", "label": "Étiquette collection", "default": "After Dark" },
    { "type": "product", "id": "product", "label": "Produit mis en avant" },
    { "type": "text", "id": "heading", "label": "Titre (si aucun produit choisi)", "default": "Blue Hour" },
    { "type": "text", "id": "description", "label": "Description (remplace celle du produit)", "default": "Cat-eye bleu nuit. Liseré argenté. Énergie after-hours." },
    { "type": "text", "id": "price_label", "label": "Prix (si aucun produit choisi)", "default": "14,90 €" },
    { "type": "text", "id": "cta_label", "label": "Bouton", "default": "Découvrir Blue Hour" },
    { "type": "image_picker", "id": "image", "label": "Photo lifestyle (placeholder tant que non définie)" }
  ],
  "presets": [
    { "name": "Shop the look" }
  ]
}
{% endschema %}
