<section class="compare-section">
  <div class="container">
    <div class="section-head reveal">
      <h2>{{ section.settings.heading }}</h2>
      <p class="section-sub">{{ section.settings.subheading }}</p>
    </div>
    <div class="compare-slider reveal" id="compareSlider">
      <div class="compare-img compare-before">
        {%- render 'placeholder-media', image: section.settings.before_image -%}
        <span class="compare-tag">{{ section.settings.before_label }}</span>
      </div>
      <div class="compare-img compare-after" id="compareAfter">
        {%- render 'placeholder-media', image: section.settings.after_image, modifier: 'photo' -%}
        <span class="compare-tag">{{ section.settings.after_label }}</span>
      </div>
      <div class="compare-handle" id="compareHandle"><span></span></div>
      <input type="range" min="0" max="100" value="50" class="compare-range" id="compareRange" aria-label="{{ section.settings.heading }}">
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Avant / Après",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Vois la différence" },
    { "type": "text", "id": "subheading", "label": "Sous-titre", "default": "Glisse pour comparer — ongles nus vs. ton look Velour." },
    { "type": "text", "id": "before_label", "label": "Étiquette avant", "default": "Avant" },
    { "type": "text", "id": "after_label", "label": "Étiquette après", "default": "Après" },
    { "type": "image_picker", "id": "before_image", "label": "Image avant (placeholder tant que non définie)" },
    { "type": "image_picker", "id": "after_image", "label": "Image après (placeholder tant que non définie)" }
  ],
  "presets": [
    { "name": "Avant / Après" }
  ]
}
{% endschema %}
