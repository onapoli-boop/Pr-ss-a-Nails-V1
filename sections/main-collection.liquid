<div class="container breadcrumb">
  <a href="{{ routes.root_url }}">{{ 'layout.breadcrumb.home' | t }}</a><span>/</span>
  <span class="current">{{ collection.title }}</span>
</div>

<section class="products" id="shop">
  <div class="container">
    <div class="section-head reveal">
      <h1 style="font-family:var(--f-display); font-weight:400; font-size:clamp(28px,3.4vw,44px); letter-spacing:-0.01em; line-height:1.05;">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <p class="section-sub">{{ collection.description | strip_html }}</p>
      {%- endif -%}
    </div>

    {%- paginate collection.products by 24 -%}
      {%- if collection.products.size > 0 -%}
        <div class="product-grid reveal">
          {%- for product in collection.products -%}
            {%- render 'product-card', product: product -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <div class="blog-cta reveal">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="btn btn-ghost">&larr;</a>{%- endif -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="btn btn-ghost">&rarr;</a>{%- endif -%}
          </div>
        {%- endif -%}
      {%- else -%}
        <p class="blog-empty">{{ 'collection.empty' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection"
}
{% endschema %}
