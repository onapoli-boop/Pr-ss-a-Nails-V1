        { "type": "text", "id": "description", "label": "Description courte", "default": "" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "7 Days · 7 Looks",
      "blocks": [
        { "type": "day", "settings": { "label": "Lundi", "day_tag": "lundi", "modifier": "" } },
        { "type": "day", "settings": { "label": "Mardi", "day_tag": "mardi", "modifier": "rose" } },
        { "type": "day", "settings": { "label": "Mercredi", "day_tag": "mercredi", "modifier": "noir" } },
        { "type": "day", "settings": { "label": "Jeudi", "day_tag": "jeudi", "modifier": "" } },
        { "type": "day", "settings": { "label": "Vendredi", "day_tag": "vendredi", "modifier": "bordeaux" } },
        { "type": "day", "settings": { "label": "Samedi", "day_tag": "samedi", "modifier": "rose" } },
        { "type": "day", "settings": { "label": "Dimanche", "day_tag": "dimanche", "modifier": "noir" } },
        { "type": "mood_option", "settings": { "key": "girlboss", "role": "weekday", "label": "Girlboss", "description": "Bureau, réunions, soignée.", "modifier": "" } },
        { "type": "mood_option", "settings": { "key": "cleangirl", "role": "weekday", "label": "Clean Girl", "description": "Décontracté, courses, sans effort.", "modifier": "rose" } },
