    },
    { "type": "header", "content": "Statistiques" },
    { "type": "text", "id": "stat_1_value", "label": "Stat 1 — valeur", "default": "7" },
    { "type": "text", "id": "stat_1_label", "label": "Stat 1 — libellé", "default": "Sets press-on" },
    { "type": "text", "id": "stat_2_value", "label": "Stat 2 — valeur", "default": "1" },
    { "type": "text", "id": "stat_2_label", "label": "Stat 2 — libellé", "default": "Semaine de looks" },
    { "type": "text", "id": "stat_3_value", "label": "Stat 3 — valeur", "default": "40" },
    { "type": "text", "id": "stat_3_suffix", "label": "Stat 3 — suffixe", "default": "€" },
    { "type": "text", "id": "stat_3_label", "label": "Stat 3 — libellé", "default": "Tout inclus" },
    { "type": "text", "id": "cta_label", "label": "Bouton — texte", "default": "Obtenir les 7 looks" },
    { "type": "text", "id": "note", "label": "Note", "default": "+ Kit soin des ongles offert inclus. Les chiffres de comparaison ci-dessous sont donnés à titre indicatif, basés sur nos prix à l'unité (8,90–18,50 €), uniquement pour cette maquette." },
    { "type": "header", "content": "Comparatif de prix" },
    { "type": "text", "id": "compare_1_label", "label": "Ligne 1 — libellé", "default": "Achetés séparément" },
    { "type": "text", "id": "compare_1_value", "label": "Ligne 1 — valeur", "default": "≈ 92 €" },
    { "type": "text", "id": "compare_1_disclaimer", "label": "Ligne 1 — mention", "default": "Exemple de maquette, pas un prix réel" },
    { "type": "text", "id": "compare_2_label", "label": "Ligne 2 — libellé", "default": "7 Days · 7 Looks" },
    { "type": "text", "id": "compare_2_value", "label": "Ligne 2 — valeur", "default": "40 €" }
  ],
  "blocks": [
    {
      "type": "day",
      "name": "Jour (calendrier)",
      "settings": [
        { "type": "text", "id": "label", "label": "Nom du jour", "default": "Lundi" },
        {
          "type": "text",
          "id": "day_tag",
          "label": "Tag produit du jour",
          "info": "Si un produit de la collection 7 Days porte ce tag, son image remplace automatiquement la couleur ci-dessous.",
          "default": "lundi"
        },
        {
          "type": "select",
          "id": "modifier",
          "label": "Variante couleur (repli si aucun produit taggé)",
          "options": [
            { "value": "", "label": "Défaut" },
            { "value": "rose", "label": "Rose" },
            { "value": "noir", "label": "Noir" },
            { "value": "bordeaux", "label": "Bordeaux" }
          ],
          "default": ""
        }
      ]
    },
    {
      "type": "mood_option",
      "name": "Option du quiz",
      "settings": [
        { "type": "text", "id": "key", "label": "Identifiant unique", "info": "ex: girlboss — sans espace, utilisé en interne", "default": "girlboss" },
        {
          "type": "select",
          "id": "role",
          "label": "Question",
          "options": [
            { "value": "weekday", "label": "Semaine (Q1)" },
            { "value": "weekend", "label": "Week-end (Q2)" }
          ],
          "default": "weekday"
        },
        { "type": "text", "id": "label", "label": "Titre", "default": "Girlboss" },
        { "type": "text", "id": "description", "label": "Description", "default": "Bureau, réunions, soignée." },
        {
          "type": "select",
          "id": "modifier",
          "label": "Variante couleur",
          "options": [
            { "value": "", "label": "Défaut" },
            { "value": "rose", "label": "Rose" },
            { "value": "noir", "label": "Noir" },
            { "value": "bordeaux", "label": "Bordeaux" }
          ],
          "default": ""
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection de ce mood",
          "info": "Ex : ta collection \"Girl Boss\", \"Clean Girl\"... Utilisée pour retrouver, via le tag de jour (lundi, mardi...) déjà présent sur tes produits, un produit différent et adapté à ce mood pour chaque jour de la semaine."
