{%- liquid
  assign day_blocks = section.blocks | where: 'type', 'day'
  assign mood_blocks = section.blocks | where: 'type', 'mood_option'
  assign size_blocks = section.blocks | where: 'type', 'size_option'

  assign day_tags = ''
  for block in day_blocks
    assign day_tags = day_tags | append: block.settings.day_tag | append: '|'
  endfor
  assign day_tags = day_tags | split: '|'
-%}

{%- comment -%}
  For each mood option, "days" maps every day tag (lundi, mardi...) to the
  full variant list of the product in that mood's own collection (Girl
  Boss, Clean Girl...) that also carries the matching day tag — so the quiz
  result can propose a different, real product per day instead of one
  single product per mood. Falls back to the mood's manually-picked
  "product" setting wherever no tagged match exists yet (safety net while
  tagging is still in progress). Full variant lists (not a single resolved
  id) are needed so the JS can pick the variant matching whichever size the
  customer answered in step 1 — see assets/theme.js pickVariant().
{%- endcomment -%}
{%- capture moods_json -%}
  {
  {%- for mood in mood_blocks -%}
    {%- assign mood_collection = mood.settings.collection -%}
    {{ mood.settings.key | json }}: {
      "label": {{ mood.settings.label | json }},
      "modifier": {{ mood.settings.modifier | json }},
      "variants": {{ mood.settings.product.variants | json }},
      "days": {
        {%- for tag in day_tags -%}
          {%- liquid
            assign day_product = blank
            if tag != blank and mood_collection
              for p in mood_collection.products
                if p.tags contains tag
                  assign day_product = p
                  break
                endif
              endfor
            endif
          -%}
          {{ tag | json }}: {% if day_product %}{{ day_product.variants | json }}{% else %}null{% endif %}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      }
    }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
  }
{%- endcapture -%}
<section class="week" id="week">
  <div class="container">
    <div class="week-head reveal">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <div class="week-calendar reveal">
      {%- for block in day_blocks -%}
        {%- liquid
          assign day_product = blank
          if block.settings.day_tag != blank and section.settings.seven_days_collection
            for p in section.settings.seven_days_collection.products
              if p.tags contains block.settings.day_tag
                assign day_product = p
                break
              endif
            endfor
          endif
        -%}
        <div class="day-card" {{ block.shopify_attributes }}>
          {%- if day_product -%}
            {%- render 'placeholder-media', image: day_product.featured_image, modifier: 'photo' -%}
          {%- else -%}
            {%- render 'placeholder-media', modifier: block.settings.modifier -%}
          {%- endif -%}
          <span class="day-label">{{ block.settings.label }}</span>
        </div>
      {%- endfor -%}
    </div>

    <div class="week-offer reveal">
      <div class="week-offer-copy">
        <div class="stat-row">
          <div class="stat"><b data-count="{{ section.settings.stat_1_value }}">0</b><span>{{ section.settings.stat_1_label }}</span></div>
          <div class="stat"><b data-count="{{ section.settings.stat_2_value }}">0</b><span>{{ section.settings.stat_2_label }}</span></div>
          <div class="stat"><b data-count="{{ section.settings.stat_3_value }}" data-suffix="{{ section.settings.stat_3_suffix }}">0</b><span>{{ section.settings.stat_3_label }}</span></div>
        </div>
        <a href="#" class="btn btn-light" id="openBuilderBtn">{{ section.settings.cta_label }}</a>
        <p class="note">{{ section.settings.note }}</p>
      </div>
      <div class="compare">
        <div class="compare-row">
          <span class="label">{{ section.settings.compare_1_label }}</span>
          <span class="val">{{ section.settings.compare_1_value }}<span class="disclaimer">{{ section.settings.compare_1_disclaimer }}</span></span>
        </div>
        <div class="compare-row highlight">
          <span class="label">{{ section.settings.compare_2_label }}</span>
          <span class="val">{{ section.settings.compare_2_value }}</span>
        </div>
      </div>
    </div>
  </div>
</section>

{%- comment -%} Look Builder — 7 Days quiz popup, triggered from #openBuilderBtn above {%- endcomment -%}
<div class="modal-overlay" id="builderOverlay"></div>
<div
  class="look-builder"
  id="lookBuilder"
  role="dialog"
  aria-modal="true"
  aria-labelledby="builderTitle"
  hidden
  data-moods='{{ moods_json | strip_newlines | strip }}'
  data-day-tags='{{ day_tags | json }}'
>
  <button class="builder-close" id="builderCloseBtn" aria-label="{{ 'general.accessibility.close' | t }}">✕</button>
  <div class="builder-progress">
    <span class="dot active" data-dot="0"></span>
    <span class="dot" data-dot="1"></span>
    <span class="dot" data-dot="2"></span>
    <span class="dot" data-dot="3"></span>
    <span class="dot" data-dot="4"></span>
  </div>

  <div class="builder-step" data-step="0">
    <span class="eyebrow">{{ 'look_builder.eyebrow' | t }}</span>
    <h3 id="builderTitle">{{ 'look_builder.intro_title' | t }}</h3>
    <p>{{ 'look_builder.intro_text' | t }}</p>
    <button class="btn btn-primary" id="builderStart">{{ 'look_builder.start' | t }}</button>
  </div>

  <div class="builder-step" data-step="1" hidden>
    <span class="eyebrow">{{ 'look_builder.step_1_of_3' | t }}</span>
    <h3>{{ 'look_builder.question_size' | t }}</h3>
    <div class="builder-options">
      {%- for block in size_blocks -%}
        <button class="builder-option" data-answer="{{ block.settings.value }}">
          <span class="opt-title">{{ block.settings.label }}</span>
          <span class="opt-desc">{{ block.settings.description }}</span>
        </button>
      {%- endfor -%}
    </div>
  </div>

  <div class="builder-step" data-step="2" hidden>
    <span class="eyebrow">{{ 'look_builder.step_2_of_3' | t }}</span>
    <h3>{{ 'look_builder.question_weekday' | t }}</h3>
    <div class="builder-options">
      {%- for block in mood_blocks -%}
        {%- if block.settings.role == 'weekday' -%}
          <button class="builder-option" data-answer="{{ block.settings.key }}">
            <span class="opt-title">{{ block.settings.label }}</span>
            <span class="opt-desc">{{ block.settings.description }}</span>
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="builder-step" data-step="3" hidden>
    <span class="eyebrow">{{ 'look_builder.step_3_of_3' | t }}</span>
    <h3>{{ 'look_builder.question_weekend' | t }}</h3>
    <div class="builder-options">
      {%- for block in mood_blocks -%}
        {%- if block.settings.role == 'weekend' -%}
          <button class="builder-option" data-answer="{{ block.settings.key }}">
            <span class="opt-title">{{ block.settings.label }}</span>
            <span class="opt-desc">{{ block.settings.description }}</span>
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="builder-step builder-result" data-step="4" hidden>
    <span class="eyebrow">{{ 'look_builder.result_eyebrow' | t }}</span>
    <h3>{{ 'look_builder.result_title' | t }}</h3>
    <p class="builder-hint">{{ 'look_builder.result_hint' | t }}</p>
    <div class="builder-days" id="builderDays"></div>
    <div class="builder-summary">
      <div>
        <span class="builder-summary-title">{{ 'look_builder.eyebrow' | t }}</span>
        <span class="builder-summary-sub">{{ section.settings.note | strip_html | truncate: 60 }}</span>
      </div>
      <span class="builder-price">{{ section.settings.compare_2_value }}</span>
    </div>
    <button class="btn btn-primary" id="builderAdd">{{ 'look_builder.add_to_cart' | t }}</button>
  </div>
</div>

{% schema %}
{
  "name": "7 Days · 7 Looks",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "L'offre signature" },
    { "type": "text", "id": "heading", "label": "Titre", "info": "HTML simple accepté : <br> et <em>.", "default": "Une semaine.<br><em>Sept moods.</em><br>Une routine simple." },
    {
      "type": "collection",
      "id": "seven_days_collection",
      "label": "Collection des sets éligibles au kit 7 Days",
