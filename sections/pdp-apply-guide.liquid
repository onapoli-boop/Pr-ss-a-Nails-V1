<section class="apply-guide">
  <div class="container">
    <div class="section-head reveal">
      <h2>{{ section.settings.heading }}</h2>
      <p class="section-sub">{{ section.settings.subheading }}</p>
    </div>
    <div class="apply-steps reveal">
      {%- for block in section.blocks -%}
        <div class="apply-step" {{ block.shopify_attributes }}>
          {%- render 'placeholder-media', image: block.settings.image, modifier: block.settings.modifier -%}
          <span class="idx">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Guide de pose (PDP)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Guide de pose" },
    { "type": "text", "id": "subheading", "label": "Sous-titre", "default": "Quatre étapes, quinze minutes, aucun temps de séchage." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Prépare" },
        { "type": "text", "id": "text", "label": "Texte", "default": "Nettoie l'ongle, repousse la cuticule et lime légèrement la surface pour une meilleure accroche." },
        { "type": "image_picker", "id": "image", "label": "Image (placeholder tant que non définie)" },
        {
          "type": "select",
          "id": "modifier",
          "label": "Variante couleur (si pas d'image)",
          "options": [
            { "value": "", "label": "Défaut" },
            { "value": "rose", "label": "Rose" },
            { "value": "noir", "label": "Noir" },
            { "value": "bordeaux", "label": "Bordeaux" }
          ],
          "default": ""
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Guide de pose (PDP)",
      "blocks": [
        { "type": "step", "settings": { "title": "Prépare", "text": "Nettoie l'ongle, repousse la cuticule et lime légèrement la surface pour une meilleure accroche.", "modifier": "rose" } },
        { "type": "step", "settings": { "title": "Ajuste", "text": "Teste chaque gabarit du kit pour trouver la bonne taille sur tes 10 ongles.", "modifier": "" } },
        { "type": "step", "settings": { "title": "Colle", "text": "Applique la languette adhésive, positionne le press-on à la base de l'ongle et presse 15 secondes.", "modifier": "bordeaux" } },
        { "type": "step", "settings": { "title": "Sublime", "text": "Lime les bords si besoin pour un rendu net, parfaitement fini.", "modifier": "noir" } }
      ]
    }
  ]
}
{% endschema %}
