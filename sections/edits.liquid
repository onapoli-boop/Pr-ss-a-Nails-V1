<section class="edits" id="edits">
  <div class="container">
    <div class="section-head reveal">
      <h2>{{ section.settings.heading }}</h2>
      <p class="section-sub">{{ section.settings.subheading }}</p>
    </div>
    <div class="edits-grid reveal">
      {%- for block in section.blocks -%}
        <a class="edit-card" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          {%- render 'placeholder-media', image: block.settings.image, modifier: block.settings.modifier -%}
          <div class="edit-info">
            <span class="eyebrow">{{ block.settings.eyebrow }}</span>
            <h3>{{ block.settings.title }}</h3>
            <div class="looks">{{ block.settings.looks_count }}</div>
            <span class="btn btn-light">{{ block.settings.cta_label }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Les sélections (bundles)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Les sélections" },
    { "type": "text", "id": "subheading", "label": "Sous-titre", "default": "Trois looks choisis pour toi, en édition limitée." }
  ],
  "blocks": [
    {
      "type": "edit",
      "name": "Sélection",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Sélection Girlboss" },
        { "type": "text", "id": "title", "label": "Titre", "default": "La Sélection Girlboss" },
        { "type": "text", "id": "looks_count", "label": "Nombre de looks", "default": "3 looks" },
        { "type": "text", "id": "cta_label", "label": "Bouton", "default": "Découvrir la sélection" },
        { "type": "url", "id": "link", "label": "Lien", "info": "Idéalement une collection dédiée à ce bundle." },
        { "type": "image_picker", "id": "image", "label": "Image (placeholder tant que non définie)" },
        {
          "type": "select",
          "id": "modifier",
          "label": "Variante couleur (si pas d'image)",
          "options": [
            { "value": "", "label": "Défaut" },
            { "value": "rose", "label": "Rose" },
            { "value": "noir", "label": "Noir" },
            { "value": "bordeaux", "label": "Bordeaux" }
          ],
          "default": ""
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Les sélections (bundles)",
      "blocks": [
        { "type": "edit", "settings": { "eyebrow": "Sélection Girlboss", "title": "La Sélection Girlboss", "looks_count": "3 looks", "modifier": "" } },
        { "type": "edit", "settings": { "eyebrow": "Sélection Soft Girl", "title": "La Sélection Soft Girl", "looks_count": "3 looks", "modifier": "rose" } },
        { "type": "edit", "settings": { "eyebrow": "Sélection After Dark", "title": "La Sélection After Dark", "looks_count": "3 looks", "modifier": "noir" } }
      ]
    }
  ]
}
{% endschema %}
