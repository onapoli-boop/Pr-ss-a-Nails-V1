<section class="capture">
  <div class="container">
    <span class="eyebrow">{{ 'newsletter.eyebrow' | t }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <p class="sub">{{ section.settings.subtext }}</p>
    {%- form 'customer', id: 'newsletterForm' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="capture-form">
        <input type="email" name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t }}" required>
        <button type="submit">{{ 'newsletter.submit' | t }}</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="note" role="status">{{ 'newsletter.success' | t }}</p>
      {%- elsif form.errors -%}
        <p class="note" role="alert">{{ 'newsletter.error' | t }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Capture email",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "info": "HTML simple accepté : <br>.", "default": "Ton prochain look<br>arrive dans ta boîte mail." },
    { "type": "text", "id": "subtext", "label": "Texte", "default": "Accède en avant-première aux nouveautés, éditions limitées et offres privées." }
  ],
  "presets": [
    { "name": "Capture email" }
  ]
}
{% endschema %}
