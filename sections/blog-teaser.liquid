{%- assign blog = section.settings.blog -%}
<section class="blog" id="journal">
  <div class="container">
    <div class="section-head reveal">
      <h2>{{ section.settings.heading }}</h2>
      <p class="section-sub">{{ section.settings.subheading }}</p>
    </div>
    <div class="blog-grid reveal">
      {%- if blog != blank -%}
        {%- for article in blog.articles limit: section.settings.articles_to_show -%}
          {%- render 'article-card', article: article -%}
        {%- endfor -%}
      {%- else -%}
        <p>{{ 'onboarding.no_collection' | t }}</p>
      {%- endif -%}
    </div>
    {%- if blog != blank -%}
      <div class="blog-cta reveal"><a href="{{ blog.url }}" class="btn btn-ghost">{{ 'blog.read_all' | t }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Le Journal (aperçu)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Le Journal" },
    { "type": "text", "id": "subheading", "label": "Sous-titre", "default": "Conseils de pose, tendances mood et coulisses de la marque." },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "articles_to_show", "label": "Nombre d'articles", "min": 2, "max": 6, "step": 1, "default": 3 }
  ],
  "presets": [
    { "name": "Le Journal (aperçu)" }
  ]
}
{% endschema %}
