<section class="mood" id="mood">
  <div class="container">
    <div class="section-head reveal">
      <h2>{{ section.settings.heading }}</h2>
      <p class="section-sub">{{ section.settings.subheading }}</p>
    </div>
    <div class="mood-grid reveal">
      {%- for block in section.blocks -%}
        <a class="mood-card" href="{{ block.settings.link | default: '#shop' }}" {{ block.shopify_attributes }}>
          {%- render 'placeholder-media', image: block.settings.image, modifier: block.settings.modifier -%}
          <div class="mood-info">
            <span class="num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
            <span class="btn btn-light">{{ block.settings.cta_label | default: 'Découvrir' }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Quel est ton mood ?",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Quel est ton mood ?" },
    { "type": "text", "id": "subheading", "label": "Sous-titre", "default": "Choisis ton esthétique avant de choisir un produit." }
  ],
  "blocks": [
    {
      "type": "mood",
      "name": "Mood",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Clean Girl" },
        { "type": "text", "id": "text", "label": "Texte", "default": "Tes ongles du lundi au vendredi, 9h-17h." },
        { "type": "text", "id": "cta_label", "label": "Bouton", "default": "Découvrir" },
        { "type": "url", "id": "link", "label": "Lien" },
        { "type": "image_picker", "id": "image", "label": "Image (placeholder tant que non définie)" },
        {
          "type": "select",
          "id": "modifier",
          "label": "Variante couleur (si pas d'image)",
          "options": [
            { "value": "", "label": "Défaut" },
            { "value": "rose", "label": "Rose" },
            { "value": "noir", "label": "Noir" },
            { "value": "bordeaux", "label": "Bordeaux" }
          ],
          "default": ""
        }
      ]
    }
  ],
  "max_blocks": 4,
  "default": {
    "blocks": [
      { "type": "mood", "settings": { "title": "Clean Girl", "text": "Tes ongles du lundi au vendredi, 9h-17h.", "modifier": "rose" } },
      { "type": "mood", "settings": { "title": "Girlboss", "text": "Soignée. Affirmée. Impeccable.", "modifier": "" } },
      { "type": "mood", "settings": { "title": "Soft Girl", "text": "Jolie, sans en faire trop.", "modifier": "" } },
      { "type": "mood", "settings": { "title": "After Dark", "text": "Tes plans commencent après 18h.", "modifier": "noir" } }
    ]
  },
  "presets": [
    { "name": "Quel est ton mood ?" }
  ]
}
{% endschema %}
