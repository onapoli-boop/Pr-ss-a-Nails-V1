{%- comment -%}
  Renders one of the header's line-icon SVGs, ported 1:1 from the mockup.
  Usage: {% render 'icon', name: 'search' %}
{%- endcomment -%}

{%- case name -%}
  {%- when 'search' -%}
    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.6" y2="16.6"/></svg>
  {%- when 'account' -%}
    <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.6"/><path d="M4.5 20c1.6-4 4.4-6 7.5-6s5.9 2 7.5 6"/></svg>
  {%- when 'cart' -%}
    <svg viewBox="0 0 24 24"><path d="M6 8h12l-1 12H7L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
  {%- when 'wishlist' -%}
    <svg viewBox="0 0 24 24"><path d="M12 20s-7-4.5-9.3-9C1 7 3 4 6.2 4c2 0 3.5 1.2 4.3 2.6C11.3 5.2 12.8 4 14.8 4 18 4 20 7 19.3 11 17 15.5 12 20 12 20z"/></svg>
  {%- when 'close' -%}
    ✕
{%- endcase -%}
